# Magister OAuth2-webclient (bij Magister geregistreerd)
# Verplicht: zonder client-id is de Magister-login uitgeschakeld.
NEXT_PUBLIC_MAGISTER_CLIENT_ID=

# Optioneel: exact overeenkomen met de geregistreerde redirect-URI.
# Standaard: {huidige origin}/auth/callback
# Productie: https://magisterpro.vercel.app/auth/callback
NEXT_PUBLIC_MAGISTER_REDIRECT_URI=

# Optioneel: standaardwaarde hieronder
NEXT_PUBLIC_MAGISTER_SCOPES=openid profile offline_access attendance.overview calendar.user grades.read

# Optioneel: "code" (standaard) of "code id_token" indien de client dat vereist
NEXT_PUBLIC_MAGISTER_RESPONSE_TYPE=code

# Alleen server-side: invullen als de geregistreerde client confidential is.
# Nooit met NEXT_PUBLIC_ prefixeren.
MAGISTER_CLIENT_SECRET=
