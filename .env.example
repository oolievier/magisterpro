# De QR-koppeling gebruikt Vercel Blob voor kortlevende koppelsessies.
# Op Vercel wordt BLOB_READ_WRITE_TOKEN automatisch aan dit project verbonden
# via de Blob store "magisterpro-qr-handshake". Lokaal is geen .env nodig:
# zonder token valt de app terug op in-memory opslag.

# Optioneel: alleen nodig als je naast de QR-koppeling ook een eigen,
# bij Magister geregistreerde OAuth-webclient wilt gebruiken.
NEXT_PUBLIC_MAGISTER_CLIENT_ID=
NEXT_PUBLIC_MAGISTER_REDIRECT_URI=
NEXT_PUBLIC_MAGISTER_SCOPES=openid profile offline_access attendance.overview calendar.user grades.read
NEXT_PUBLIC_MAGISTER_RESPONSE_TYPE=code
MAGISTER_CLIENT_SECRET=
